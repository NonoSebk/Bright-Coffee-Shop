{
  "datasets": [
    {
      "name": "coffee_sales",
      "displayName": "Coffee Sales",
      "config": {
        "version": "1.1",
        "source": "retail.default.bright_coffee_shop",
        "dimensions": [
          {
            "name": "transaction_id",
            "expr": "transaction_id"
          },
          {
            "name": "transaction_date",
            "expr": "transaction_date"
          },
          {
            "name": "transaction_time",
            "expr": "transaction_time"
          },
          {
            "name": "month",
            "expr": "DATE_TRUNC('MONTH', transaction_date)"
          },
          {
            "name": "day_of_week",
            "expr": "DAYOFWEEK(transaction_date)"
          },
          {
            "name": "day_name",
            "expr": "DATE_FORMAT(transaction_date, 'EEEE')"
          },
          {
            "name": "hour",
            "expr": "HOUR(transaction_time)"
          },
          {
            "name": "time_bucket",
            "expr": "CASE \n  WHEN HOUR(transaction_time) BETWEEN 0 AND 5 THEN 'Early Morning (00:00-05:59)'\n  WHEN HOUR(transaction_time) BETWEEN 6 AND 11 THEN 'Morning (06:00-11:59)'\n  WHEN HOUR(transaction_time) BETWEEN 12 AND 16 THEN 'Afternoon (12:00-16:59)'\n  WHEN HOUR(transaction_time) BETWEEN 17 AND 20 THEN 'Evening (17:00-20:59)'\n  ELSE 'Night (21:00-23:59)'\nEND\n"
          },
          {
            "name": "store_id",
            "expr": "store_id"
          },
          {
            "name": "store_location",
            "expr": "store_location"
          },
          {
            "name": "product_id",
            "expr": "product_id"
          },
          {
            "name": "product_category",
            "expr": "product_category"
          },
          {
            "name": "product_type",
            "expr": "product_type"
          },
          {
            "name": "product_detail",
            "expr": "product_detail"
          },
          {
            "name": "unit_price_numeric",
            "expr": "CAST(REPLACE(unit_price, ',', '.') AS DECIMAL(10,2))"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(CAST(REPLACE(unit_price, ',', '.') AS DECIMAL(10,2)) * transaction_qty)"
          },
          {
            "name": "total_transactions",
            "expr": "COUNT(DISTINCT transaction_id)"
          },
          {
            "name": "total_quantity",
            "expr": "SUM(transaction_qty)"
          },
          {
            "name": "avg_transaction_value",
            "expr": "SUM(CAST(REPLACE(unit_price, ',', '.') AS DECIMAL(10,2)) * transaction_qty) / COUNT(DISTINCT transaction_id)"
          },
          {
            "name": "avg_unit_price",
            "expr": "AVG(CAST(REPLACE(unit_price, ',', '.') AS DECIMAL(10,2)))"
          }
        ]
      }
    },
    {
      "name": "top_store",
      "displayName": "Top Performing Store",
      "config": {
        "version": "1.1",
        "source": "retail.default.bright_coffee_shop",
        "dimensions": [
          {
            "name": "store_location",
            "expr": "store_location"
          }
        ],
        "measures": [
          {
            "name": "store_revenue",
            "expr": "SUM(CAST(REPLACE(unit_price, ',', '.') AS DECIMAL(10,2)) * transaction_qty)"
          }
        ]
      }
    },
    {
      "name": "best_product",
      "displayName": "Best Selling Product",
      "config": {
        "version": "1.1",
        "source": "retail.default.bright_coffee_shop",
        "dimensions": [
          {
            "name": "product_detail",
            "expr": "product_detail"
          }
        ],
        "measures": [
          {
            "name": "product_revenue",
            "expr": "SUM(CAST(REPLACE(unit_price, ',', '.') AS DECIMAL(10,2)) * transaction_qty)"
          }
        ]
      }
    }
  ],
